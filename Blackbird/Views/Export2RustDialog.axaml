<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Blackbird.ViewModels"
        xmlns:views="using:Blackbird.Views"
        x:Class="Blackbird.Views.Export2RustDialog"
        x:DataType="vm:Export2RustDialogViewModel"
        WindowStartupLocation="CenterOwner"
        Classes="dialog tool"
        Title="Export2Rust"
        Width="940" Height="620"
        MinWidth="720" MinHeight="480">

    <views:DialogShell Title="Export2Rust"
                       Subtitle="Queued files are exported together in one export2rust run.">
        <views:DialogShell.Status>
            <Grid ColumnDefinitions="Auto,*">
                <ProgressBar Width="120"
                             Margin="0,0,12,0"
                             MinWidth="0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             IsVisible="{Binding ShowProgress}"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Classes="status"
                           Classes.error="{Binding HasError}"
                           Text="{Binding StatusText}"/>
            </Grid>
        </views:DialogShell.Status>

        <views:DialogShell.Footer>
            <StackPanel Classes="dialog-buttons">
                <Button Content="Export"
                        Command="{Binding RunCommand}"
                        IsEnabled="{Binding CanRun}"
                        IsDefault="True"
                        IsVisible="{Binding !IsRunning}"
                        ToolTip.Tip="{Binding RunDisabledReason}"
                        ToolTip.ShowOnDisabled="True"
                        Theme="{StaticResource AccentButton}"/>
                <Button Content="Stop"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="Files that haven't finished stay in the queue as stopped"
                        IsEnabled="{Binding !IsStopping}"
                        IsVisible="{Binding IsRunning}"
                        Theme="{StaticResource SubtleButton}"/>
                <Button Content="Close"
                        Click="OnCloseClick"
                        IsCancel="True"
                        Theme="{StaticResource SubtleButton}"/>
            </StackPanel>
        </views:DialogShell.Footer>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Border Name="DropZone"
                    Classes="card"
                    DragDrop.AllowDrop="True">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <TextBlock Text="&#xE8E5;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="24"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentIndicator}"/>
                    <TextBlock Grid.Column="1"
                               Classes="section"
                               Text="Drop files here to queue them"
                               VerticalAlignment="Center"/>
                    <Button Name="AddFilesButton"
                            Grid.Column="2"
                            Content="Add files…"
                            Click="OnAddFilesClick"
                            IsEnabled="{Binding !IsRunning}"
                            MinWidth="96"
                            Theme="{StaticResource SubtleButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,320"
                  ColumnSpacing="12">
                <Border Classes="card" Padding="0,4" ClipToBounds="True">
                    <Panel>
                        <ListBox Name="JobsList"
                                 ItemsSource="{Binding Jobs}"
                                 Classes="in-card"
                                 SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Export queue">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:Export2RustJob">
                                    <Grid ColumnDefinitions="Auto,*,Auto,56" ColumnSpacing="12" MinHeight="40">
                                        <TextBlock Text="{Binding StatusGlyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14"
                                                   Foreground="{Binding StatusBrush}"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding StatusText}"
                                                   AutomationProperties.Name="{Binding StatusText}"/>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding FilePath}"/>
                                            <TextBlock Classes="hint"
                                                       Text="{Binding SecondLine}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="PathSegmentEllipsis"
                                                       ToolTip.Tip="{Binding SecondLine}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Classes="hint"
                                                   Text="{Binding SizeText}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                        <TextBlock Grid.Column="3"
                                                   Classes="hint"
                                                   Text="{Binding DurationText}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Classes="hint"
                                   Text="Nothing queued. Drop files above, or use Add files."
                                   IsVisible="{Binding !HasJobs}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Panel>
                </Border>

                <Grid Grid.Column="1"
                      RowDefinitions="Auto,*"
                      RowSpacing="8">
                    <TextBlock Classes="label" Text="Output"/>
                    <TextBox Name="OutputBox"
                             Grid.Row="1"
                             Text="{Binding SelectedOutput}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="12"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="Remove"
                        Command="{Binding RemoveSelectedJobCommand}"
                        IsEnabled="{Binding CanRemoveSelectedJob}"
                        ToolTip.Tip="Remove the selected file from the queue (Delete)"
                        MinWidth="96"
                        Theme="{StaticResource SubtleButton}"/>
                <Button Content="Clear queue"
                        Command="{Binding ClearCommand}"
                        IsEnabled="{Binding CanClear}"
                        MinWidth="96"
                        Theme="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </views:DialogShell>
</Window>
